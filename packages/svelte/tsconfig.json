{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["@webgpu/types"],
    "baseUrl": ".",
    "paths": {
      "@graphmother/core": ["../core/mod.ts"],
      "@graphmother/wasm": ["../wasm/pkg/graphmother_wasm.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../core/src/shims.d.ts"],
  "exclude": ["node_modules", "dist"]
}
