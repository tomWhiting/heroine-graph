{
  "name": "@graphmother/svelte",
  "version": "0.3.0",
  "description": "Svelte wrapper for GraphMother - high-performance graph visualization",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bunx svelte-package -i src -o dist",
    "dev": "bunx svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "deno lint src"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "dependencies": {
    "@graphmother/core": "^0.3.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@webgpu/types": "^0.1.69",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "svelte",
    "graph",
    "visualization",
    "webgpu",
    "graphmother"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomWhiting/graphmother.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/tomWhiting/graphmother",
  "bugs": {
    "url": "https://github.com/tomWhiting/graphmother/issues"
  },
  "sideEffects": false
}
