{
  "name": "@graphmother/core",
  "version": "0.1.0",
  "description": "High-performance graph visualization using WebGPU",
  "type": "module",
  "main": "./dist/heroine-graph.esm.js",
  "module": "./dist/heroine-graph.esm.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/heroine-graph.esm.js"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "mod.ts",
    "LICENSE"
  ],
  "scripts": {
    "build": "deno run -A ../../scripts/build_core_types.ts && deno run -A npm:esbuild@^0.24.0/esbuild mod.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/heroine-graph.esm.js --loader:.wgsl=text --external:@graphmother/wasm",
    "build:bundle": "deno run -A npm:esbuild@^0.24.0/esbuild mod.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/heroine-graph.esm.js --loader:.wgsl=text --external:@graphmother/wasm",
    "build:types": "deno run -A ../../scripts/build_core_types.ts"
  },
  "dependencies": {
    "@graphmother/wasm": "^0.1.0",
    "@webgpu/types": "^0.1.69"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "graph",
    "visualization",
    "webgpu",
    "wasm",
    "force-directed",
    "network",
    "graphmother"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomWhiting/heroine-graph.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tomWhiting/heroine-graph",
  "bugs": {
    "url": "https://github.com/tomWhiting/heroine-graph/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  }
}
