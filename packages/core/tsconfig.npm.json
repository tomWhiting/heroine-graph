{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "paths": {
      "@graphmother/wasm": ["../wasm/pkg/heroine_graph_wasm.d.ts"]
    },
    "baseUrl": "."
  },
  "include": ["mod.ts", "src/**/*.ts", "src/shims.d.ts"],
  "exclude": ["node_modules", "dist"]
}
