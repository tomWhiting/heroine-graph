{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["@webgpu/types"],
    "baseUrl": ".",
    "paths": {
      "@graphmother/core": ["../core/mod.ts"],
      "@graphmother/wasm": ["../wasm/pkg/graphmother_wasm.d.ts"]
    }
  },
  "include": ["src", "../core/src/shims.d.ts"],
  "exclude": ["node_modules", "dist"]
}
