{
  "name": "@graphmother/react",
  "version": "0.1.0",
  "description": "React wrapper for GraphMother - high-performance graph visualization",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "deno run -A npm:tsup@^8.3.0/tsup",
    "dev": "deno run -A npm:tsup@^8.3.0/tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "tsup": {
    "entry": ["src/index.ts"],
    "format": ["esm"],
    "dts": {
      "compilerOptions": {
        "jsx": "react-jsx",
        "moduleResolution": "bundler"
      }
    },
    "clean": true
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@graphmother/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "react",
    "graph",
    "visualization",
    "webgpu",
    "graphmother"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomWhiting/graphmother.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/tomWhiting/graphmother",
  "bugs": {
    "url": "https://github.com/tomWhiting/graphmother/issues"
  },
  "sideEffects": false
}
