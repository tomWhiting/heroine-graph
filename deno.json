{
  "name": "@graphmother/monorepo",
  "version": "0.5.0",
  "workspace": [
    "./packages/core",
    "./packages/react",
    "./packages/vue",
    "./packages/svelte"
  ],
  "tasks": {
    "dev": "deno run --watch packages/core/mod.ts",
    "serve": "deno run --allow-net --allow-read jsr:@std/http/file-server",
    "build": "deno run -A scripts/build.ts",
    "build:wasm": "cd packages/wasm && ./build.sh",
    "bundle": "bunx esbuild packages/core/mod.ts --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --outfile=dist/graphmother.esm.js --loader:.wgsl=text --external:@graphmother/wasm && cp packages/wasm/pkg/graphmother_wasm.js packages/wasm/pkg/graphmother_wasm_bg.wasm dist/",
    "test": "deno test --allow-read --allow-net --allow-env --unstable-webgpu tests/",
    "test:coverage": "deno test --allow-read --allow-net --allow-env --unstable-webgpu --coverage=coverage tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check packages/core/mod.ts",
    "bench": "deno bench --allow-read --allow-net --allow-env --unstable-webgpu tests/benchmarks/",
    "storybook": "bunx storybook dev -p 6006 --ci",
    "storybook:build": "bunx storybook build",
    "storybook:clean": "rm -rf node_modules/.cache",
    "publish": "deno run -A scripts/publish.ts",
    "publish:dry": "deno run -A scripts/publish.ts --dry-run",
    "example:code-graph:build": "deno run -A scripts/build_example.ts",
    "example:code-graph": "deno task example:code-graph:build && deno run --allow-net --allow-read jsr:@std/http/file-server examples/code-graph/dist --port 1573"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable", "deno.webgpu"]
  },
  "lint": {
    "include": ["packages/", "tests/", "examples/"],
    "exclude": ["**/node_modules/", "**/dist/", "**/pkg/", "stories/"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "eqeqeq",
        "no-const-assign",
        "no-eval",
        "no-throw-literal"
      ],
      "exclude": ["require-await"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": ["packages/", "tests/", "examples/"],
    "exclude": [
      "**/node_modules/",
      "**/dist/",
      "**/pkg/",
      "**/*.wgsl"
    ]
  },
  "imports": {
    "@graphmother/core": "./packages/core/mod.ts",
    "@graphmother/wasm": "./packages/wasm/pkg/graphmother_wasm.js"
  },
  "exclude": ["**/node_modules/", "**/dist/", "**/pkg/", "**/target/"]
}
